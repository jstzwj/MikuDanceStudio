#include <winver.h>

1 VERSIONINFO
FILEVERSION @MDS_VERSION_MAJOR@,@MDS_VERSION_MINOR@,0,0
PRODUCTVERSION @MDS_VERSION_MAJOR@,@MDS_VERSION_MINOR@,0,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "MikuDanceStudio\0"
            VALUE "FileVersion", "@MDS_VERSION@\0"
            VALUE "InternalName", "MikuDanceStudio\0"
            VALUE "OriginalFilename", "MikuDanceStudio.exe\0"
            VALUE "ProductName", "MikuDanceStudio\0"
            VALUE "ProductVersion", "@MDS_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
