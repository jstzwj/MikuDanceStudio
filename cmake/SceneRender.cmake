function(mds_add_scene_render)
    if(TARGET mikudancestudio_scene_render OR NOT TARGET mikudancestudio_rhi)
        return()
    endif()
    get_filename_component(mds_root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)
    add_library(mikudancestudio_scene_render STATIC "${mds_root}/src/render/scene_frame_producer.cpp")
    target_link_libraries(mikudancestudio_scene_render PUBLIC mikudancestudio_scene_runtime mikudancestudio_rhi)
    if(MSVC)
        target_compile_options(mikudancestudio_scene_render PRIVATE /fp:precise /utf-8)
    else()
        target_compile_options(mikudancestudio_scene_render PRIVATE -ffp-contract=off)
    endif()
    add_executable(mds_render_cli "${mds_root}/src/tools/render_cli.cpp")
    target_link_libraries(mds_render_cli PRIVATE mikudancestudio_scene_render)
endfunction()
