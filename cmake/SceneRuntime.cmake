function(mds_add_scene_runtime physics_target)
    if(TARGET mikudancestudio_scene_runtime OR NOT TARGET mikudancestudio_model_runtime)
        return()
    endif()
    get_filename_component(mds_root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)
    add_library(mikudancestudio_scene_runtime STATIC "${mds_root}/src/physics/model_physics_runtime.cpp" "${mds_root}/src/model/scene_runtime.cpp")
    target_compile_definitions(mikudancestudio_scene_runtime PRIVATE NOMINMAX)
    target_compile_features(mikudancestudio_scene_runtime PUBLIC cxx_std_17)
    target_link_libraries(mikudancestudio_scene_runtime PUBLIC mikudancestudio_model_runtime ${physics_target})
    add_executable(mds_cpu_scene_cli "${mds_root}/src/tools/scene_runtime_cli.cpp")
    target_link_libraries(mds_cpu_scene_cli PRIVATE mikudancestudio_scene_runtime)
    if(MSVC)
        target_compile_options(mikudancestudio_scene_runtime PRIVATE /fp:precise /utf-8)
    else()
        target_compile_options(mikudancestudio_scene_runtime PRIVATE -ffp-contract=off)
    endif()
    # Capture the complete offline production graph, including the pinned
    # Bullet libraries. Conan builds use the same sources through its recipe;
    # the portable CI entry point audits those sources and the final executable.
    if(TARGET bullet275)
        set(graph "{")
        foreach(name IN ITEMS mds_cpu_scene_cli mikudancestudio_scene_runtime mikudancestudio_model_runtime
                mikudancestudio_cpu_math mikudancestudio_formats ${physics_target}
                BULLET275::BULLET275 BulletDynamics BulletCollision LinearMath mikudancestudio_math)
            if(NOT TARGET ${name})
                continue()
            endif()
            get_target_property(sources ${name} SOURCES)
            get_target_property(directory ${name} SOURCE_DIR)
            get_target_property(links ${name} LINK_LIBRARIES)
            if(NOT links)
                get_target_property(links ${name} INTERFACE_LINK_LIBRARIES)
            endif()
            if(NOT links)
                set(links "")
            endif()
            set(absolute_sources "")
            if(sources)
                foreach(source IN LISTS sources)
                    get_filename_component(source "${source}" ABSOLUTE BASE_DIR "${directory}")
                    list(APPEND absolute_sources "${source}")
                endforeach()
            endif()
            string(REGEX REPLACE "\\$<LINK_ONLY:([^>]+)>" "\\1" links "${links}")
            string(REPLACE ";" "\",\"" absolute_sources "${absolute_sources}")
            string(REPLACE ";" "\",\"" links "${links}")
            if(NOT graph STREQUAL "{")
                string(APPEND graph ",")
            endif()
            string(APPEND graph "\"${name}\":{\"sources\":[\"${absolute_sources}\"],\"links\":[\"${links}\"]}")
        endforeach()
        file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/generated/scene_runtime_targets.json" CONTENT "${graph}}\n")
    endif()
    if(BUILD_TESTING)
        # Explicit local-asset runner. Public CI uses generated redistributable
        # fixtures; no private model path or bytes are embedded in the project.
        add_executable(scene_runtime_real_test "${mds_root}/tests/scene_runtime_real_test.cpp")
        target_link_libraries(scene_runtime_real_test PRIVATE mikudancestudio_scene_runtime)
        add_executable(scene_runtime_test "${mds_root}/tests/scene_runtime_test.cpp")
        target_link_libraries(scene_runtime_test PRIVATE mikudancestudio_scene_runtime)
        add_test(NAME scene_runtime COMMAND ${Python3_EXECUTABLE} "${mds_root}/tests/test_runtime_cpu_scene.py" --test $<TARGET_FILE:scene_runtime_test>)
        set_tests_properties(scene_runtime PROPERTIES LABELS "headless;portable;p2" TIMEOUT 120)
        add_test(NAME scene_runtime_cli COMMAND ${Python3_EXECUTABLE} "${mds_root}/tools/check_scene_runtime.py"
            --program $<TARGET_FILE:mds_cpu_scene_cli> --output "${CMAKE_CURRENT_BINARY_DIR}/p2")
        set_tests_properties(scene_runtime_cli PROPERTIES LABELS "headless;portable;p2" TIMEOUT 120)
        if(TARGET bullet275)
            add_test(NAME scene_runtime_dependencies COMMAND ${Python3_EXECUTABLE} "${mds_root}/tools/audit_model_runtime.py"
                --program $<TARGET_FILE:mds_cpu_scene_cli> --manifest "${CMAKE_CURRENT_BINARY_DIR}/generated/scene_runtime_targets.json"
                --stage P2 --output "${CMAKE_CURRENT_BINARY_DIR}/p2-dependencies.json")
            set_tests_properties(scene_runtime_dependencies PROPERTIES LABELS "headless;portable;p2")
        endif()
    endif()
endfunction()
