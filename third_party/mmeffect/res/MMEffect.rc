IDD_MME_LOG DIALOGEX 0, 0, 321, 204
STYLE DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "MMEffect Log"
LANGUAGE LANG_JAPANESE, 0x1
FONT 8, "MS Shell Dlg", 400, 0, 1
{
   CONTROL "Close", 2, BUTTON, BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 140, 186, 50, 14 
   CONTROL "", 1001, EDIT, ES_LEFT | ES_MULTILINE | ES_READONLY | ES_WANTRETURN | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_VSCROLL | WS_TABSTOP, 7, 7, 307, 175 
}

IDD_MME_MAPPING DIALOGEX 0, 0, 373, 215
STYLE DS_SHELLFONT | WS_MAXIMIZEBOX | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
