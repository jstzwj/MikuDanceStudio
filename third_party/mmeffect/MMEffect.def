; MMEffect.def - host integration export table for embedded MMEffect.dll.
;
; The original MMEffect.dll's 11 callback exports are no longer needed (the MMHack layer is replaced by host MmeHost*
; integration, with direct calls inside the same module); export only the host bridge integration surface here.
LIBRARY MMEffect
EXPORTS
    MmeHostBeginScene
    MmeHostClear
    MmeHostDestroyDevice
    MmeHostDrawIndexedPrimitive
    MmeHostDrawPrimitive
    MmeHostEffectsActive
    MmeHostHasAssignedEffects
    MmeHostEndScene
    MmeHostNotifyPmmLoaded
    MmeHostNotifyPmmSaved
    MmeHostOnLostDevice
    MmeHostOnResetDevice
    MmeHostPreRenderTargetCopy
    MmeHostRecordTextureFile
    MmeHostSetDrawnWindow
    MmeHostSetMainWindow
    MmeHostSetPathProviders
    MmeHostSetStandardEffect
